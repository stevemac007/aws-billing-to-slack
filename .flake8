[flake8]
max-line-length = 127
max-complexity = 15
exclude = 
    .git,
    __pycache__,
    .aws-sam,
    .serverless,
    node_modules,
    venv,
    env,
    .venv,
    .env
ignore = 
    # Allow complex functions for now (the report_cost function is inherently complex)
    C901,
    # Allow line breaks before binary operators (black style)
    W503
per-file-ignores =
    # Allow unused imports in __init__.py files
    __init__.py:F401